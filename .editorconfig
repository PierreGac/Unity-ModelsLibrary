# EditorConfig is awesome:http://EditorConfig.org

# top-most EditorConfig file
root = true

# Don't use tabs for indentation.
[*]
indent_style = space
# (Please don't specify an indent_size here; that has too many unintended consequences.)

# Code files
[*.{cs,csx,vb,vbx}]
indent_size = 4
insert_final_newline = true
charset = utf-8-bom

# Xml project files
[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,shproj}]
indent_size = 4

# Xml config files
[*.{props,targets,ruleset,config,nuspec,resx,vsixmanifest,vsct}]
indent_size = 4

# JSON files
[*.json]
indent_size = 4

# Dotnet code style settings:
[*.{cs,vb}]
# Sort using and Import directives with System.* appearing first
dotnet_sort_system_directives_first = true
# Avoid "this." and "Me." if not necessary
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Use language keywords instead of framework type names for type references
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_require_accessibility_modifiers = always:error

# Suggest more modern language features when available
dotnet_style_object_initializer = true:error
dotnet_style_collection_initializer = true:error
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_readonly_field = false:none
dotnet_diagnostic.IDE0044.severity = none

csharp_preferred_modifier_order = public,protected,internal,private,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async

# Naming rules

# Define the 'private_fields' symbol group:
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private,protected

# Define the 'private_static_fields' symbol group
dotnet_naming_symbols.private_static_fields.applicable_kinds = field,property
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

# Define the 'underscored' naming style
dotnet_naming_style.underscored.capitalization = camel_case
dotnet_naming_style.underscored.required_prefix = _

# Define the 'private_fields_underscored' naming rule
dotnet_naming_rule.private_fields_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_underscored.style = underscored
dotnet_naming_rule.private_fields_underscored.severity = error

# Define the 'private_static_fields_none' naming rule
dotnet_naming_rule.private_static_fields_none.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_none.style = underscored
dotnet_naming_rule.private_static_fields_none.severity = error


# Define the 'public_fields' symbol group:
dotnet_naming_symbols.public_fields.applicable_kinds = field,property,local,parameter,type_parameter
dotnet_naming_symbols.public_fields.applicable_accessibilities = public,local

# Define the 'public_static_fields' symbol group
dotnet_naming_symbols.public_static_fields.applicable_kinds = field,property
dotnet_naming_symbols.public_static_fields.applicable_accessibilities = public,internal
dotnet_naming_symbols.public_static_fields.required_modifiers = static

# Define the 'public_camel_case' naming style
dotnet_naming_style.public_camel_case.capitalization = camel_case

# Define the 'public_fields' naming rule
dotnet_naming_rule.public_fields.symbols = public_fields
dotnet_naming_rule.public_fields.style = public_camel_case
dotnet_naming_rule.public_fields.severity = error

# Define the 'public_static_fields' naming rule
dotnet_naming_rule.public_static_fields.symbols = public_static_fields
dotnet_naming_rule.public_static_fields.style = public_camel_case
dotnet_naming_rule.public_static_fields.severity = error

# Define the 'underscored_consts' symbol group:
dotnet_naming_symbols.underscored_consts.applicable_kinds = field
dotnet_naming_symbols.underscored_consts.applicable_accessibilities = private,protected,internal,protected_internal,private_protected
dotnet_naming_symbols.underscored_consts.required_modifiers = const

# Define the 'public_consts' symbol group:
dotnet_naming_symbols.public_consts.applicable_kinds = field
dotnet_naming_symbols.public_consts.applicable_accessibilities = public
dotnet_naming_symbols.public_consts.required_modifiers = const

# Define the 'public_const' naming style
dotnet_naming_style.public_const.capitalization = all_upper

# Define the 'underscored_const' naming style
dotnet_naming_style.underscored_const.capitalization = all_upper
dotnet_naming_style.underscored_const.required_prefix = __

# Define the 'public_consts' naming rule
dotnet_naming_rule.public_consts.symbols = public_consts
dotnet_naming_rule.public_consts.style = public_const
dotnet_naming_rule.public_consts.severity = error

# Define the 'private_consts' naming rule
dotnet_naming_rule.underscored_consts.symbols = underscored_consts
dotnet_naming_rule.underscored_consts.style = underscored_const
dotnet_naming_rule.underscored_consts.severity = error

# Define the 'interfaces' symbol group:
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
# Define the 'interface_style' naming style
dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_style.interface_style.required_prefix = I
# Define the 'interfaces' naming rule
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_style
dotnet_naming_rule.interfaces.severity = error

# Define the 'classes' symbol group:
dotnet_naming_symbols.classes.applicable_kinds = class,struct,method
dotnet_naming_symbols.classes.applicable_accessibilities = *
# Define the 'class_style' naming style
dotnet_naming_style.class_style.capitalization = pascal_case
# Define the 'classes' naming rule
dotnet_naming_rule.classes.symbols = classes
dotnet_naming_rule.classes.style = class_style
dotnet_naming_rule.classes.severity = error

dotnet_diagnostic.IDE0001.severity = warning      # Simplify names                                System.Version version;                             Version version;
dotnet_diagnostic.IDE0002.severity = warning      # Simplify (member access)                      System.Version.Equals("1", "2");                    Version.Equals("1", "2");


# CSharp code style settings:
[*.cs]
# Indentation preferences
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# Prefer "var" everywhere
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# Prefer method-like constructs to have a block body
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = true:suggestion
csharp_style_expression_bodied_operators = false:none

# Prefer property-like constructs to have an expression-body
csharp_style_expression_bodied_properties = when_on_single_line:warning
csharp_style_expression_bodied_indexers = when_on_single_line:warning
csharp_style_expression_bodied_accessors = when_on_single_line:warning


# Suggest more modern language features when available
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_inlined_variable_declaration = true:error
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:error
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = false:none
csharp_prefer_simple_using_statement = false:none
dotnet_diagnostic.CS0219.severity = none

# Newline settings
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# Blocks are allowed
csharp_prefer_braces = true:error
csharp_using_directive_placement = outside_namespace:error

# Expression-level preferences
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_prefer_simple_default_expression = true:warning
csharp_style_prefer_local_over_anonymous_function = true:warning
csharp_style_inlined_variable_declaration = true:suggestion
